<templateSet group="Playwright">
  <template name="log" value="console.log($END$);" description="console.log()" toReformat="false" toShortenFQNames="false">
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwt" value="test(&quot;$NAME$&quot;, async ({ page$FIXTURES$ }) =&gt; {&#10;    $END$&#10;});" description="Playwright test" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;test name&quot;" alwaysStopAt="true"/>
    <variable name="FIXTURES" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwd" value="test.describe(&quot;$NAME$&quot;, () =&gt; {&#10;    $END$&#10;});" description="Playwright test.describe" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;suite name&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwstep" value="await test.step(&quot;$NAME$&quot;, async () =&gt; {&#10;    $END$&#10;});" description="await test.step(...)" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;step name&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwbe" value="test.beforeEach(async ({ page$FIXTURES$ }) =&gt; {&#10;    $END$&#10;});" description="test.beforeEach" toReformat="false" toShortenFQNames="false">
    <variable name="FIXTURES" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwexp" value="await expect(page.locator($LOCATOR$)).$ASSERT$($END$);" description="await expect(locator) assertion" toReformat="false" toShortenFQNames="false">
    <variable name="LOCATOR" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
    <variable name="ASSERT" expression="enum(&quot;toBeVisible&quot;, &quot;toHaveText&quot;, &quot;toContainText&quot;, &quot;toHaveCount&quot;, &quot;toHaveValue&quot;, &quot;toBeEnabled&quot;, &quot;toBeHidden&quot;)" defaultValue="&quot;toBeVisible&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwloc" value="page.locator(&quot;$SELECTOR$&quot;)$END$" description="page.locator(...)" toReformat="false" toShortenFQNames="false">
    <variable name="SELECTOR" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwfix" value="$NAME$: async ({ page }, use) =&gt; { await use(new $CLASS$(page)) },$END$" description="Fixture for test.extend (Page Object)" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;mainPage&quot;" alwaysStopAt="true"/>
    <variable name="CLASS" expression="" defaultValue="&quot;MainPage&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwpage" value="import { Page } from &quot;@playwright/test&quot;;&#10;&#10;export default class $CLASS$ {&#10;    private page: Page;&#10;    path = &quot;$PATH$&quot;;&#10;&#10;    constructor(page: Page) {&#10;        this.page = page;&#10;    }&#10;&#10;    selectors = {&#10;        $END$&#10;    }&#10;&#10;    public async open() {&#10;        await this.page.goto(this.path);&#10;    }&#10;}" description="Page Object class (selectors, path, open)" toReformat="false" toShortenFQNames="false">
    <variable name="CLASS" expression="" defaultValue="&quot;MainPage&quot;" alwaysStopAt="true"/>
    <variable name="PATH" expression="" defaultValue="&quot;/&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <!-- generated by tools/live-templates.py -->
  <template name="pwba" value="test.beforeAll(async ({ $FIXTURES$ }) =&gt; {&#10;    $END$&#10;});" description="test.beforeAll" toReformat="false" toShortenFQNames="false">
    <variable name="FIXTURES" expression="" defaultValue="&quot;browser&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwae" value="test.afterEach(async ({ page$FIXTURES$ }) =&gt; {&#10;    $END$&#10;});" description="test.afterEach" toReformat="false" toShortenFQNames="false">
    <variable name="FIXTURES" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwaa" value="test.afterAll(async () =&gt; {&#10;    $END$&#10;});" description="test.afterAll" toReformat="false" toShortenFQNames="false">
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwonly" value="test.only(&quot;$NAME$&quot;, async ({ page$FIXTURES$ }) =&gt; {&#10;    $END$&#10;});" description="test.only - run only this test" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;test name&quot;" alwaysStopAt="true"/>
    <variable name="FIXTURES" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwskip" value="test.skip(&quot;$NAME$&quot;, async ({ page$FIXTURES$ }) =&gt; {&#10;    $END$&#10;});" description="test.skip" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;test name&quot;" alwaysStopAt="true"/>
    <variable name="FIXTURES" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwfixme" value="test.fixme(&quot;$NAME$&quot;, async ({ page$FIXTURES$ }) =&gt; {&#10;    $END$&#10;});" description="test.fixme" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;test name&quot;" alwaysStopAt="true"/>
    <variable name="FIXTURES" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwdser" value="test.describe.serial(&quot;$NAME$&quot;, () =&gt; {&#10;    $END$&#10;});" description="test.describe.serial" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;suite name&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwuse" value="test.use({ $END$ });" description="test.use({ ... })" toReformat="false" toShortenFQNames="false">
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwslow" value="test.slow();$END$" description="test.slow() - triple the timeout" toReformat="false" toShortenFQNames="false">
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwpause" value="await page.pause();$END$" description="await page.pause() - stop in the Playwright Inspector" toReformat="false" toShortenFQNames="false">
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwgoto" value="await page.goto(&quot;$URL$&quot;);$END$" description="await page.goto(...)" toReformat="false" toShortenFQNames="false">
    <variable name="URL" expression="" defaultValue="&quot;/&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwclick" value="await page.locator(&quot;$SELECTOR$&quot;).click();$END$" description="await page.locator(...).click()" toReformat="false" toShortenFQNames="false">
    <variable name="SELECTOR" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwfill" value="await page.locator(&quot;$SELECTOR$&quot;).fill(&quot;$VALUE$&quot;);$END$" description="await page.locator(...).fill(...)" toReformat="false" toShortenFQNames="false">
    <variable name="SELECTOR" expression="" defaultValue="" alwaysStopAt="true"/>
    <variable name="VALUE" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwrole" value="page.getByRole(&quot;$ROLE$&quot;, { name: &quot;$NAME$&quot; })$END$" description="page.getByRole(...)" toReformat="false" toShortenFQNames="false">
    <variable name="ROLE" expression="enum(&quot;button&quot;, &quot;link&quot;, &quot;textbox&quot;, &quot;checkbox&quot;, &quot;radio&quot;, &quot;combobox&quot;, &quot;heading&quot;, &quot;listitem&quot;, &quot;option&quot;, &quot;tab&quot;, &quot;dialog&quot;, &quot;img&quot;, &quot;row&quot;, &quot;cell&quot;)" defaultValue="&quot;button&quot;" alwaysStopAt="true"/>
    <variable name="NAME" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwtid" value="page.getByTestId(&quot;$ID$&quot;)$END$" description="page.getByTestId(...)" toReformat="false" toShortenFQNames="false">
    <variable name="ID" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwtext" value="page.getByText(&quot;$TEXT$&quot;)$END$" description="page.getByText(...)" toReformat="false" toShortenFQNames="false">
    <variable name="TEXT" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwlabel" value="page.getByLabel(&quot;$LABEL$&quot;)$END$" description="page.getByLabel(...)" toReformat="false" toShortenFQNames="false">
    <variable name="LABEL" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwvis" value="await expect(page.locator(&quot;$SELECTOR$&quot;)).toBeVisible();$END$" description="expect(locator).toBeVisible()" toReformat="false" toShortenFQNames="false">
    <variable name="SELECTOR" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwhave" value="await expect(page.locator(&quot;$SELECTOR$&quot;)).toHaveText(&quot;$TEXT$&quot;);$END$" description="expect(locator).toHaveText(...)" toReformat="false" toShortenFQNames="false">
    <variable name="SELECTOR" expression="" defaultValue="" alwaysStopAt="true"/>
    <variable name="TEXT" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwurl" value="await expect(page).toHaveURL($URL$);$END$" description="expect(page).toHaveURL(...)" toReformat="false" toShortenFQNames="false">
    <variable name="URL" expression="" defaultValue="&quot;/\\/path/&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwtitle" value="await expect(page).toHaveTitle(&quot;$TITLE$&quot;);$END$" description="expect(page).toHaveTitle(...)" toReformat="false" toShortenFQNames="false">
    <variable name="TITLE" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwsoft" value="await expect.soft($ACTUAL$).$ASSERT$($END$);" description="expect.soft(...) - the test goes on after a failure" toReformat="false" toShortenFQNames="false">
    <variable name="ACTUAL" expression="" defaultValue="" alwaysStopAt="true"/>
    <variable name="ASSERT" expression="enum(&quot;toBe&quot;, &quot;toEqual&quot;, &quot;toHaveText&quot;, &quot;toBeVisible&quot;, &quot;toContainText&quot;)" defaultValue="&quot;toBe&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwpoll" value="await expect.poll(async () =&gt; {&#10;    $END$&#10;}, { timeout: $TIMEOUT$ }).toBe($EXPECTED$);" description="expect.poll - retry until the value matches" toReformat="false" toShortenFQNames="false">
    <variable name="TIMEOUT" expression="" defaultValue="&quot;10000&quot;" alwaysStopAt="true"/>
    <variable name="EXPECTED" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwwait" value="const $NAME$Promise = page.waitForResponse((response) =&gt; response.url().includes(&quot;$URL$&quot;) &amp;&amp; response.status() === 200);&#10;$END$&#10;const $NAME$ = await $NAME$Promise;" description="Wait for an API response: the promise first, then the action that triggers it" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;response&quot;" alwaysStopAt="true"/>
    <variable name="URL" expression="" defaultValue="&quot;/api/&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwroute" value="await page.route(&quot;$PATTERN$&quot;, async (route) =&gt; {&#10;    await route.fulfill({ json: $END$ });&#10;});" description="Mock an API response with page.route" toReformat="false" toShortenFQNames="false">
    <variable name="PATTERN" expression="" defaultValue="&quot;**/api/**&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwapi" value="const $NAME$ = await request.$METHOD$(&quot;$URL$&quot;$END$);&#10;expect($NAME$.ok()).toBeTruthy();" description="API request with the request fixture" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;response&quot;" alwaysStopAt="true"/>
    <variable name="METHOD" expression="enum(&quot;get&quot;, &quot;post&quot;, &quot;put&quot;, &quot;patch&quot;, &quot;delete&quot;)" defaultValue="&quot;get&quot;" alwaysStopAt="true"/>
    <variable name="URL" expression="" defaultValue="&quot;/api/&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwshot" value="await page.screenshot({ path: &quot;$PATH$&quot;, fullPage: true });$END$" description="page.screenshot(...)" toReformat="false" toShortenFQNames="false">
    <variable name="PATH" expression="" defaultValue="&quot;screenshot.png&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwattach" value="await test.info().attach(&quot;$NAME$&quot;, { body: $BODY$, contentType: &quot;$TYPE$&quot; });$END$" description="Attach data to the report" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;data&quot;" alwaysStopAt="true"/>
    <variable name="BODY" expression="" defaultValue="" alwaysStopAt="true"/>
    <variable name="TYPE" expression="enum(&quot;application/json&quot;, &quot;text/plain&quot;, &quot;image/png&quot;)" defaultValue="&quot;application/json&quot;" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
  <template name="pwann" value="test.info().annotations.push({ type: &quot;$TYPE$&quot;, description: &quot;$DESCRIPTION$&quot; });$END$" description="Annotation of the test (issue, link...)" toReformat="false" toShortenFQNames="false">
    <variable name="TYPE" expression="" defaultValue="&quot;issue&quot;" alwaysStopAt="true"/>
    <variable name="DESCRIPTION" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="PLAYWRIGHT" value="true"/>
    </context>
  </template>
</templateSet>
