<idea-plugin>
    <id>dev.pwtoolkit.gigaide</id>
    <name>Playwright Toolkit for GigaIDE</name>
    <vendor url="https://github.com/tepmehatop/gigaide-playwright-toolkit">tepmehatop</vendor>
    <description><![CDATA[
    Tools for writing Playwright tests in TypeScript/JavaScript in GigaIDE (and other IntelliJ-based IDEs without
    the commercial JavaScript plugin):
    <ul>
      <li><b>Go to Declaration</b> (Ctrl/Cmd+Click) for TS/JS resolved by the TypeScript language server (native TypeScript 7, or tsserver.js / typescript-language-server on Node.js):
          fixtures from <code>test.extend</code>, Page Object methods and fields, local object properties, imports, JSON.</li>
      <li><b>TypeScript errors</b> in the editor with quick fixes (Alt+Enter: Add import...).</li>
      <li><b>Parameter info</b> (Ctrl+P, on click inside a call, after a comma), <b>parameter name hints</b>,
          <b>quick documentation</b> on hover (Ctrl+Q), <b>Find Usages</b> (Alt+F7) and <b>Structure</b> (Cmd+F12)
          from the TypeScript server.</li>
      <li><b>Code completion</b> from the TypeScript server (with auto-import): members of <code>page</code>, locators, fixtures and Page Objects;
          <code>log</code> and <code>.log</code> templates for <code>console.log</code>.</li>
      <li><b>Playwright Test</b> run configuration with Run/Debug gutter icons next to <code>test(...)</code> and
          <code>test.describe(...)</code>.</li>
      <li><b>Test tree</b> in Run and Debug: statuses, clickable stacks and attachments, expected/actual diff,
          Rerun Failed Tests; trace, screenshots and playwright-extended-report from the tree.</li>
      <li><b>Show Browser</b> (one browser kept open between runs) and <b>Explore locators</b>
          (the locator under the caret is highlighted in that browser).</li>
      <li><b>Debugging with breakpoints</b> in tests, fixtures and Page Objects (via vscode-js-debug, shipped with GigaIDE):
          stepping, variables, watches, Evaluate Expression, conditional breakpoints.</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <gotoDeclarationHandler implementation="dev.pwtoolkit.nav.TsGotoDeclarationHandler" order="first"/>
        <completion.contributor language="any" implementationClass="dev.pwtoolkit.completion.TsCompletionContributor" order="first"/>
        <typedHandler implementation="dev.pwtoolkit.completion.TsAutoPopupHandler"/>
        <findUsagesHandlerFactory implementation="dev.pwtoolkit.nav.TsFindUsagesHandlerFactory" order="first"/>
        <intentionMenuContributor implementation="dev.pwtoolkit.refactor.TsRefactorIntentions"/>
        <annotator language="TypeScript" implementationClass="dev.pwtoolkit.run.PwSelectorAnnotator"/>
        <annotator language="JavaScript" implementationClass="dev.pwtoolkit.run.PwSelectorAnnotator"/>
        <annotator language="TSX" implementationClass="dev.pwtoolkit.run.PwSelectorAnnotator"/>
        <definitionsScopedSearch implementation="dev.pwtoolkit.nav.TsImplementationSearch"/>
        <callHierarchyProvider language="TypeScript" implementationClass="dev.pwtoolkit.nav.TsCallHierarchyProvider" order="first"/>
        <callHierarchyProvider language="JavaScript" implementationClass="dev.pwtoolkit.nav.TsCallHierarchyProvider" order="first"/>
        <callHierarchyProvider language="TSX" implementationClass="dev.pwtoolkit.nav.TsCallHierarchyProvider" order="first"/>
        <codeInsight.gotoSuper language="TypeScript" implementationClass="dev.pwtoolkit.nav.TsGotoSuperHandler" order="first"/>
        <codeInsight.lineMarkerProvider language="TypeScript" implementationClass="dev.pwtoolkit.nav.TsHierarchyLineMarkerProvider"/>
        <codeInsight.gotoSuper language="JavaScript" implementationClass="dev.pwtoolkit.nav.TsGotoSuperHandler" order="first"/>
        <codeInsight.lineMarkerProvider language="JavaScript" implementationClass="dev.pwtoolkit.nav.TsHierarchyLineMarkerProvider"/>
        <codeInsight.gotoSuper language="TSX" implementationClass="dev.pwtoolkit.nav.TsGotoSuperHandler" order="first"/>
        <codeInsight.lineMarkerProvider language="TSX" implementationClass="dev.pwtoolkit.nav.TsHierarchyLineMarkerProvider"/>
        <lang.refactoringSupport language="TypeScript" implementationClass="dev.pwtoolkit.refactor.TsRefactoringSupport" order="first"/>
        <lang.refactoringSupport language="JavaScript" implementationClass="dev.pwtoolkit.refactor.TsRefactoringSupport" order="first"/>
        <lang.refactoringSupport language="TSX" implementationClass="dev.pwtoolkit.refactor.TsRefactoringSupport" order="first"/>
        <typeDeclarationProvider implementation="dev.pwtoolkit.nav.TsTypeDeclarationProvider" order="first"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="dev.pwtoolkit.nav.TsUsagesCodeVisionProvider"/>
        <codeInsight.typeInfo language="TypeScript" implementationClass="dev.pwtoolkit.nav.TsTypeInfoProvider" order="first"/>
        <codeInsight.typeInfo language="JavaScript" implementationClass="dev.pwtoolkit.nav.TsTypeInfoProvider" order="first"/>
        <codeInsight.typeInfo language="TSX" implementationClass="dev.pwtoolkit.nav.TsTypeInfoProvider" order="first"/>
        <targetElementEvaluator language="TypeScript" implementationClass="dev.pwtoolkit.nav.TsTargetElementEvaluator" order="first"/>
        <targetElementEvaluator language="JavaScript" implementationClass="dev.pwtoolkit.nav.TsTargetElementEvaluator" order="first"/>
        <targetElementEvaluator language="TSX" implementationClass="dev.pwtoolkit.nav.TsTargetElementEvaluator" order="first"/>
        <lang.psiStructureViewFactory language="TypeScript" implementationClass="dev.pwtoolkit.nav.TsStructureViewFactory" order="first"/>
        <lang.psiStructureViewFactory language="JavaScript" implementationClass="dev.pwtoolkit.nav.TsStructureViewFactory" order="first"/>
        <lang.psiStructureViewFactory language="TSX" implementationClass="dev.pwtoolkit.nav.TsStructureViewFactory" order="first"/>
        <codeInsight.parameterInfo language="TypeScript" implementationClass="dev.pwtoolkit.completion.TsParameterInfoHandler" order="first"/>
        <lang.documentationProvider language="TypeScript" implementationClass="dev.pwtoolkit.nav.TsDocumentationProvider" order="first"/>
        <codeInsight.parameterInfo language="JavaScript" implementationClass="dev.pwtoolkit.completion.TsParameterInfoHandler" order="first"/>
        <lang.documentationProvider language="JavaScript" implementationClass="dev.pwtoolkit.nav.TsDocumentationProvider" order="first"/>
        <codeInsight.parameterInfo language="TSX" implementationClass="dev.pwtoolkit.completion.TsParameterInfoHandler" order="first"/>
        <lang.documentationProvider language="TSX" implementationClass="dev.pwtoolkit.nav.TsDocumentationProvider" order="first"/>
        <externalAnnotator language="TypeScript" implementationClass="dev.pwtoolkit.nav.TsDiagnostics$Annotator"/>
        <externalAnnotator language="JavaScript" implementationClass="dev.pwtoolkit.nav.TsDiagnostics$Annotator"/>
        <externalAnnotator language="TSX" implementationClass="dev.pwtoolkit.nav.TsDiagnostics$Annotator"/>
        <codeInsight.template.postfixTemplateProvider language="TypeScript" implementationClass="dev.pwtoolkit.completion.TsPostfixTemplateProvider"/>
        <codeInsight.template.postfixTemplateProvider language="JavaScript" implementationClass="dev.pwtoolkit.completion.TsPostfixTemplateProvider"/>
        <codeInsight.template.postfixTemplateProvider language="TSX" implementationClass="dev.pwtoolkit.completion.TsPostfixTemplateProvider"/>

        <configurationType implementation="dev.pwtoolkit.run.PwRunConfigurationType"/>
        <runConfigurationProducer implementation="dev.pwtoolkit.run.PwConfigurationProducer"/>

        <runLineMarkerContributor language="TypeScript" implementationClass="dev.pwtoolkit.run.PwTestLineMarkerContributor"/>
        <runLineMarkerContributor language="JavaScript" implementationClass="dev.pwtoolkit.run.PwTestLineMarkerContributor"/>
        <runLineMarkerContributor language="TSX" implementationClass="dev.pwtoolkit.run.PwTestLineMarkerContributor"/>
        <programRunner implementation="dev.pwtoolkit.debug.PwDebugRunner"/>
        <xdebugger.breakpointType implementation="dev.pwtoolkit.debug.PwLineBreakpointType"/>

        <applicationConfigurable parentId="tools" instance="dev.pwtoolkit.settings.PwConfigurable"
                                 id="dev.pwtoolkit.settings" displayName="Playwright Toolkit"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/PwToolkitDarcula.xml"/>
        <liveTemplateContext contextId="PLAYWRIGHT" implementation="dev.pwtoolkit.templates.PwTemplateContextType"/>
        <defaultLiveTemplates file="/liveTemplates/Playwright.xml"/>
        <notificationGroup id="Playwright Toolkit" displayType="BALLOON"/>
        <internalFileTemplate name="Playwright Test"/>
    </extensions>

    <actions>
        <action id="dev.pwtoolkit.NewPlaywrightTest" class="dev.pwtoolkit.templates.PwNewTestAction"
                text="Playwright Test" description="Create a Playwright test file">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFromTemplate"/>
        </action>
        <group id="dev.pwtoolkit.TestTreeActions">
            <separator/>
            <action id="dev.pwtoolkit.OpenTrace" class="dev.pwtoolkit.tests.PwTestTreeActions$OpenTrace"
                    text="Open Trace" description="Open the trace of this test in Playwright Trace Viewer"/>
            <action id="dev.pwtoolkit.OpenAttachment" class="dev.pwtoolkit.tests.PwTestTreeActions$OpenAttachment"
                    text="Open Screenshot / Attachment..." description="Screenshots, video, error context of this test"/>
            <action id="dev.pwtoolkit.OpenInReport" class="dev.pwtoolkit.tests.PwTestTreeActions$OpenInReport"
                    text="Open in Report" description="Open this test in playwright-extended-report (or the HTML report)"/>
            <add-to-group group-id="TestTreePopupMenu" anchor="last"/>
        </group>
        <group id="dev.pwtoolkit.ToolsMenu" text="Playwright" popup="true">
            <action id="dev.pwtoolkit.ReuseBrowser" class="dev.pwtoolkit.run.PwBrowserActions$ToggleReuse"
                    text="Show Browser (Keep Open Between Runs)" description="Run and debug tests in one visible browser that stays open"/>
            <action id="dev.pwtoolkit.CloseBrowser" class="dev.pwtoolkit.run.PwBrowserActions$Close"
                    text="Close Browser" description="Close the browser kept open between runs"/>
            <separator/>
            <action id="dev.pwtoolkit.ShowReport" class="dev.pwtoolkit.tests.PwToolsActions$ShowReport"
                    text="Show Report" description="Open playwright-extended-report or the Playwright HTML report"/>
            <action id="dev.pwtoolkit.PickLocator" class="dev.pwtoolkit.tests.PwPickLocatorAction"
                    text="Pick Locator in Browser" description="Click an element in the browser kept open by Show Browser: its locator is inserted at the caret">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
            <action id="dev.pwtoolkit.Codegen" class="dev.pwtoolkit.tests.PwToolsActions$Codegen"
                    text="Record New Test (Codegen)..." description="Record browser actions as Playwright code"/>
            <action id="dev.pwtoolkit.InstallBrowsers" class="dev.pwtoolkit.tests.PwToolsActions$InstallBrowsers"
                    text="Install Browsers" description="playwright install for the project's Playwright version"/>
            <action id="dev.pwtoolkit.CheckEnvironment" class="dev.pwtoolkit.tests.PwToolsActions$CheckEnvironment"
                    text="Check Environment" description="Node.js, Playwright, browsers, TypeScript 7, js-debug"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
        <action id="dev.pwtoolkit.DiagnoseHighlighting" class="dev.pwtoolkit.nav.HighlightingDiagnosticsAction"
                text="Diagnose Highlighting"
                description="Copy all highlighters of the caret line (layers, keys, colors) for troubleshooting">
            <add-to-group group-id="dev.pwtoolkit.ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="dev.pwtoolkit.compat.GigaJestMarkerWorkaround" topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="dev.pwtoolkit.nav.TsWarmUpListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
