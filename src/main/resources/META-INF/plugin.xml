<idea-plugin>
    <id>dev.pwtoolkit.gigaide</id>
    <name>Playwright Toolkit for GigaIDE</name>
    <vendor url="https://github.com/tepmehatop/gigaide-playwright-toolkit">tepmehatop</vendor>
    <description><![CDATA[
    Tools for writing Playwright tests in TypeScript/JavaScript in GigaIDE (and other IntelliJ-based IDEs without
    the commercial JavaScript plugin):
    <ul>
      <li><b>Go to Declaration</b> (Ctrl/Cmd+Click) for TS/JS resolved by the native TypeScript 7 language server:
          fixtures from <code>test.extend</code>, Page Object methods and fields, local object properties, imports, JSON.</li>
      <li><b>Playwright Test</b> run configuration with Run/Debug gutter icons next to <code>test(...)</code> and
          <code>test.describe(...)</code>.</li>
      <li><b>Debugging with breakpoints</b> in tests, fixtures and Page Objects (via vscode-js-debug, shipped with GigaIDE):
          stepping, variables, watches, Evaluate Expression, conditional breakpoints.</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <gotoDeclarationHandler implementation="dev.pwtoolkit.nav.TsGotoDeclarationHandler" order="first"/>

        <configurationType implementation="dev.pwtoolkit.run.PwRunConfigurationType"/>
        <runConfigurationProducer implementation="dev.pwtoolkit.run.PwConfigurationProducer"/>

        <runLineMarkerContributor language="TypeScript" implementationClass="dev.pwtoolkit.run.PwTestLineMarkerContributor"/>
        <runLineMarkerContributor language="JavaScript" implementationClass="dev.pwtoolkit.run.PwTestLineMarkerContributor"/>
        <runLineMarkerContributor language="TSX" implementationClass="dev.pwtoolkit.run.PwTestLineMarkerContributor"/>
        <programRunner implementation="dev.pwtoolkit.debug.PwDebugRunner"/>
        <xdebugger.breakpointType implementation="dev.pwtoolkit.debug.PwLineBreakpointType"/>

        <applicationConfigurable parentId="tools" instance="dev.pwtoolkit.settings.PwConfigurable"
                                 id="dev.pwtoolkit.settings" displayName="Playwright Toolkit"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/PwToolkitDarcula.xml"/>
        <notificationGroup id="Playwright Toolkit" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="dev.pwtoolkit.TestTreeActions">
            <separator/>
            <action id="dev.pwtoolkit.OpenTrace" class="dev.pwtoolkit.tests.PwTestTreeActions$OpenTrace"
                    text="Open Trace" description="Open the trace of this test in Playwright Trace Viewer"/>
            <action id="dev.pwtoolkit.OpenAttachment" class="dev.pwtoolkit.tests.PwTestTreeActions$OpenAttachment"
                    text="Open Screenshot / Attachment..." description="Screenshots, video, error context of this test"/>
            <action id="dev.pwtoolkit.OpenInReport" class="dev.pwtoolkit.tests.PwTestTreeActions$OpenInReport"
                    text="Open in Report" description="Open this test in playwright-extended-report (or the HTML report)"/>
            <add-to-group group-id="TestTreePopupMenu" anchor="last"/>
        </group>
        <group id="dev.pwtoolkit.ToolsMenu" text="Playwright" popup="true">
            <action id="dev.pwtoolkit.ShowReport" class="dev.pwtoolkit.tests.PwToolsActions$ShowReport"
                    text="Show Report" description="Open playwright-extended-report or the Playwright HTML report"/>
            <action id="dev.pwtoolkit.Codegen" class="dev.pwtoolkit.tests.PwToolsActions$Codegen"
                    text="Record New Test (Codegen)..." description="Record browser actions as Playwright code"/>
            <action id="dev.pwtoolkit.InstallBrowsers" class="dev.pwtoolkit.tests.PwToolsActions$InstallBrowsers"
                    text="Install Browsers" description="playwright install for the project's Playwright version"/>
            <action id="dev.pwtoolkit.CheckEnvironment" class="dev.pwtoolkit.tests.PwToolsActions$CheckEnvironment"
                    text="Check Environment" description="Node.js, Playwright, browsers, TypeScript 7, js-debug"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
        <action id="dev.pwtoolkit.DiagnoseHighlighting" class="dev.pwtoolkit.nav.HighlightingDiagnosticsAction"
                text="Diagnose Highlighting"
                description="Copy all highlighters of the caret line (layers, keys, colors) for troubleshooting">
            <add-to-group group-id="dev.pwtoolkit.ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="dev.pwtoolkit.compat.GigaJestMarkerWorkaround" topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="dev.pwtoolkit.nav.TsWarmUpListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
